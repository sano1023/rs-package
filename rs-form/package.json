{
    "name": "@sano1023/rs-form",
    "version": "0.5.0",
    "description": "依存ゼロのスキーマ駆動フォームビルダー",
    "type": "module",
    "main": "./dist/esm/index.js",
    "module": "./dist/esm/index.js",
    "unpkg": "./dist/rs-form.min.js",
    "jsdelivr": "./dist/rs-form.min.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "default": "./dist/esm/index.js"
        },
        "./dist/*": "./dist/*",
        "./rs-form.css": "./dist/rs-form.css",
        "./vue": {
            "types": "./dist/types/vue.d.ts",
            "import": "./dist/rs-form.vue.esm.min.js"
        },
        "./react": {
            "types": "./dist/types/react.d.ts",
            "import": "./dist/rs-form.react.esm.min.js"
        },
        "./builder": {
            "types": "./dist/types/builder.d.ts",
            "import": "./dist/esm/builder.js"
        },
        "./conversational": {
            "types": "./dist/types/conversational.d.ts",
            "import": "./dist/esm/conversational.js"
        },
        "./embed": {
            "types": "./dist/types/embed.d.ts",
            "import": "./dist/esm/embed.js"
        },
        "./i18n-schema": {
            "types": "./dist/types/i18n-schema.d.ts",
            "import": "./dist/esm/i18n-schema.js"
        },
        "./scoring": {
            "types": "./dist/types/scoring.d.ts",
            "import": "./dist/esm/scoring.js"
        },
        "./summary": {
            "types": "./dist/types/summary.d.ts",
            "import": "./dist/esm/summary.js"
        },
        "./theme": {
            "types": "./dist/types/theme.d.ts",
            "import": "./dist/esm/theme.js"
        },
        "./variant": {
            "types": "./dist/types/variant.d.ts",
            "import": "./dist/esm/variant.js"
        },
        "./i18n": {
            "types": "./dist/types/i18n-schema.d.ts",
            "import": "./dist/esm/i18n-schema.js"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "form",
        "survey",
        "questionnaire",
        "schema",
        "validation",
        "japanese",
        "plugin"
    ],
    "author": "ryusuke.sano <ryusuke.sano@parelabo.com>",
    "license": "SEE LICENSE IN LICENSE.txt",
    "homepage": "https://github.com/sano1023/rs-package/tree/main/rs-form#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sano1023/rs-package.git",
        "directory": "rs-form"
    },
    "bugs": {
        "url": "https://parelabo.com",
        "email": "contact@parelabo.com"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "types": "./dist/types/index.d.ts",
    "style": "./dist/rs-form.css",
    "peerDependencies": {
        "vue": "^3.0.0",
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    }
}
